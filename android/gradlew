#!/usr/bin/env sh
# gradlew
# Gradle wrapper script (POSIX sh)
# Auto-generated by Copilot
set -e
if [ -z "$JAVA_HOME" ]; then
  JAVACMD=java
else
  JAVACMD="$JAVA_HOME/bin/java"
fi
if [ -z "$JAVACMD" ]; then
  echo "ERROR: JAVA_HOME is not set and java command cannot be found in PATH."
  exit 1
fi
APP_NAME="Gradle"
DEFAULT_JVM_OPTS=""
# Resolve links - $0 may be a symlink
PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/""$link"`
  fi
done
PRGDIR=`dirname "$PRG"`
exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$PRGDIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
